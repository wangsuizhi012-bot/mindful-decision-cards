<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--  Background  -->
    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface" />

    <LinearLayout
        android:id="@+id/overlay_sheet_quote_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <!-- Bottom Sheet (same ids as the blocking sheet so dismiss animation is shared) -->
        <LinearLayout
            android:id="@+id/overlay_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_rounded_top_lg"
            android:backgroundTint="@color/tertiaryContainer"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp">

            <!--  Sheet handle-->
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                android:background="@drawable/shape_rounded_sm"
                android:backgroundTint="@color/primaryContainer" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="always">

                <!--  Sheet body    -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">


                    <!--  Header card  -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_rounded_md"
                        android:backgroundTint="@color/secondaryContainer"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!--  Header row  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!--   App icon   -->
                            <ImageView
                                android:id="@+id/overlay_card_app_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_rounded_sm"
                                android:clipToOutline="true"
                                android:contentDescription="@string/app_name"
                                android:src="@mipmap/ic_launcher"
                                tools:ignore="UnusedAttribute" />

                            <!--   App info column  -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingHorizontal="10dp">

                                <!--   App name   -->
                                <TextView
                                    android:id="@+id/overlay_card_app_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/app_name"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!--   Card title   -->
                                <TextView
                                    android:id="@+id/overlay_card_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/decision_card_default_title"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!--  Skip button    -->
                            <Button
                                android:id="@+id/overlay_card_btn_skip"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_rounded_md"
                                android:backgroundTint="@color/primaryContainer"
                                android:paddingVertical="0dp"
                                android:text="@string/decision_card_btn_skip"
                                android:textAllCaps="false"
                                android:textColor="@color/textSecondary" />

                        </LinearLayout>

                        <!--   Question   -->
                        <TextView
                            android:id="@+id/overlay_card_question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="10dp"
                            android:text="@string/decision_card_default_question"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!--  Route options (populated dynamically)  -->
                    <LinearLayout
                        android:id="@+id/overlay_card_routes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp" />

                    <!--  Steps list (populated dynamically)  -->
                    <LinearLayout
                        android:id="@+id/overlay_card_steps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:visibility="gone" />

                    <!--  Progress + next step button  -->
                    <LinearLayout
                        android:id="@+id/overlay_card_foot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:visibility="gone">

                        <!--  Progress  -->
                        <TextView
                            android:id="@+id/overlay_card_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/decision_card_default_progress"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />

                        <!--  Next / finish button  -->
                        <Button
                            android:id="@+id/overlay_card_btn_next"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_rounded_md"
                            android:backgroundTint="@color/accent"
                            android:text="@string/decision_card_btn_next"
                            android:textAllCaps="false"
                            android:textColor="@color/secondaryContainer" />
                    </LinearLayout>

                    <!--  Done card  -->
                    <LinearLayout
                        android:id="@+id/overlay_card_done"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:visibility="gone">

                        <!--  Done message  -->
                        <TextView
                            android:id="@+id/overlay_card_done_msg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/decision_card_default_done"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!--  Done supporting line  -->
                        <TextView
                            android:id="@+id/overlay_card_done_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:text="@string/decision_card_default_done_sub"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />

                        <!--  Enter app button  -->
                        <Button
                            android:id="@+id/overlay_card_btn_enter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/shape_rounded_md"
                            android:backgroundTint="@color/accent"
                            android:text="@string/decision_card_btn_enter"
                            android:textAllCaps="false"
                            android:textColor="@color/secondaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
